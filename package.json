{
  "name": "@itemstage/mcp",
  "version": "0.1.0",
  "description": "MCP server for ItemStage: jobs, items, locations, questions, photos and workflow moves for AI assistants. Runs as a Cloudflare Worker (streamable HTTP) or locally over stdio.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "itemstage-mcp": "./dist/bin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251101.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.86.0"
  }
}
